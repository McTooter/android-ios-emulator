{
  "formatVersion": 2,
  "guestName": "LineageOS ARM64-only UTM guest",
  "androidApiLevel": 35,
  "architecture": "arm64-v8a",
  "machine": "virt",
  "bootMode": "uefi",
  "firmware": "Data/efi_vars.fd",
  "firmwareFormat": "qcow2",
  "disks": [
    {"id": "vda", "path": "Data/vda.qcow2", "format": "qcow2"},
    {"id": "vdb", "path": "Data/vdb.qcow2", "format": "qcow2"}
  ],
  "verifiedBoot": false,
  "graphics": {
    "device": "virtio-gpu",
    "renderer": "angle-opengl"
  },
  "network": {
    "device": "virtio-net",
    "mode": "user"
  },
